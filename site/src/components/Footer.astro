---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import { REPO_URL } from '../../site.config.mjs';

const pages = (await getCollection('pages')).sort((a, b) => a.data.order - b.data.order);
const sections = ['Use cases', 'Guides', 'Compare', 'Docs'] as const;
const groups = sections.map((s) => ({ name: s, pages: pages.filter((p) => p.data.section === s) }));
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label="roost home"><Logo /><span class="brand-name">roost</span></a>
      <p>Open-source infrastructure for AI employees: one durable agent per customer.</p>
      <p class="footer-fine">Apache-2.0. Built on <a href="https://github.com/earendil-works/pi/tree/main/packages/durable" rel="noopener">Pi Durable</a> and <a href="https://e2b.dev" rel="noopener">E2B</a>; roost is not affiliated with either.</p>
    </div>
    {groups.map((g) => (
      <div>
        <h2 class="footer-h">{g.name}</h2>
        <ul>
          {g.pages.map((p) => <li><a href={`/${p.id}/`}>{p.data.nav}</a></li>)}
          {g.name === 'Docs' && (
            <>
              <li><a href={`${REPO_URL}/blob/main/docs/rfcs/0001-durable-agent-runtime.md`} rel="noopener">Design RFC</a></li>
              <li><a href={`${REPO_URL}/blob/main/docs/specs/contracts.md`} rel="noopener">API contracts</a></li>
              <li><a href={REPO_URL} rel="noopener">GitHub</a></li>
              <li><a href="/llms.txt">llms.txt</a></li>
            </>
          )}
        </ul>
      </div>
    ))}
  </div>
</footer>
