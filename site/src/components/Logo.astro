---
// The roost mark: a bird on a perch. Drawn with currentColor and the accent.
interface Props { size?: number }
const { size = 26 } = Astro.props;
---
<svg class="logo-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <path d="M7 21.5c0-6.4 4.6-11.5 10.4-11.5 3.1 0 5.6 1.5 6.9 3.8L29 15.4l-4.1 1.3c.1.5.1 1 .1 1.5 0 1.3-.3 2.4-.9 3.3Z" fill="currentColor" />
  <circle cx="20.6" cy="14.6" r="1.35" fill="var(--bg)" />
  <path d="M10.5 21.5 7.5 25" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
  <rect x="3" y="24.5" width="26" height="2.6" rx="1.3" fill="var(--accent)" />
</svg>
