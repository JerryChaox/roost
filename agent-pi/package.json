{
  "name": "roost-agent-pi",
  "version": "0.1.0",
  "private": true,
  "description": "roost agent host embedding Pi Durable",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "bin": { "roost-agent-pi": "dist/main.js" },
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
